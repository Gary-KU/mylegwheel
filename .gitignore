*.pyc
*.pyo

# Local snapshots, debug logs and editor state.
/backups/
/diagnostics/
/docs/
*.zip
*.uvguix.*
/MDK-ARM/DebugConfig/
.vscode/

# Standalone nested git repos (kept as separate repositories).
/projects/

# Simulation outputs and caches (regenerable by running the .m scripts).
*.mat
*.slxc
models/**/archive/
models/**/cache/
models/**/codegen/
models/**/results/
models/**/sim_cache/
models/lqr/simulation/output/
